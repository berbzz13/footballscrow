generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  uniqueId    String   @unique @default(cuid()) // Masks real names for privacy
  email       String   @unique
  password    String
  role        String
  name        String
  phoneNumber String?  // Replaces email reliance
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  talentProfile  TalentProfile?
  academyProfile AcademyProfile?
  clubProfile    ClubProfile?
  agentProfile   AgentProfile?

  // Existing Relations
  uploadedVideos   Video[]    @relation("TalentVideos")
  interests        Interest[] @relation("ViewerInterests")
  dealsAsTalent    Deal[]     @relation("TalentDeals")
  dealsAsClubAgent Deal[]     @relation("ClubAgentDeals")
  messages         Message[]

  // New Relations for Academy, Shortlists, and Messaging
  academyPlayers         Player[]         @relation("AcademyPlayers")
  shortlists             Shortlist[]      @relation("UserShortlists")
  shortlistedAsTalent    Shortlist[]      @relation("TalentShortlisted")
  sentDirectMessages     DirectMessage[]  @relation("SentDirectMessages")
  receivedDirectMessages DirectMessage[]  @relation("ReceivedDirectMessages")
}

// NEW: Allows Academies to create players without login credentials
model Player {
  id            String   @id @default(cuid())
  uniqueId      String   @unique @default(cuid())
  name          String   // Real name (Hidden from Clubs/Agents)
  age           Int?
  position      String?
  nationality   String?
  height        String?
  weight        String?
  preferredFoot String?
  profileImage  String?

  academyId     String
  academy       User     @relation("AcademyPlayers", fields: [academyId], references: [id], onDelete: Cascade)

  videos        Video[]
  deals         Deal[]
  shortlists    Shortlist[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model TalentProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  position    String?
  age         Int?
  nationality String?
  dateOfBirth DateTime? // <-- Added
  nin         String?   @unique // <-- Added (Marked unique so it can't be used twice)
}

model AcademyProfile {
  id       String  @id @default(cuid())
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String?
  location String?
  bio      String?
  logo     String?
  website  String?
  founded  String?
}

model ClubProfile {
  id      String  @id @default(cuid())
  userId  String  @unique
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name    String?
  league  String?
  country String?
  bio     String?
  logo    String?
  website String?
}

model AgentProfile {
  id            String  @id @default(cuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio           String?
  licenseNumber String?
  country       String?
  agency        String?
}

model Video {
  id           String   @id @default(cuid())
  title        String
  description  String?
  videoUrl     String
  thumbnailUrl String?

  // Updates: Video can belong to an independent Talent OR an Academy's Player
  talentId     String?
  talent       User?    @relation("TalentVideos", fields: [talentId], references: [id], onDelete: Cascade)
  playerId     String?
  player       Player?  @relation(fields: [playerId], references: [id], onDelete: Cascade)

  views        Int      @default(0)
  duration     String?
  tags         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  interests Interest[]
  deals     Deal[]
}

model Interest {
  id        String   @id @default(cuid())
  viewerId  String
  viewer    User     @relation("ViewerInterests", fields: [viewerId], references: [id], onDelete: Cascade)
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  status    String   @default("interested")
  note      String?
  createdAt DateTime @default(now())

  @@unique([viewerId, videoId])
}

model Deal {
  id          String   @id @default(cuid())

  // Updates: Deal can be for an independent Talent OR an Academy's Player
  talentId    String?
  talent      User?    @relation("TalentDeals", fields: [talentId], references: [id], onDelete: Cascade)
  playerId    String?
  player      Player?  @relation(fields: [playerId], references: [id], onDelete: Cascade)

  clubAgentId String
  clubAgent   User     @relation("ClubAgentDeals", fields: [clubAgentId], references: [id], onDelete: Cascade)
  videoId     String?
  video       Video?   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  status      String   @default("pending")
  dealType    String?
  proposedFee String?
  adminNotes  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages Message[]
}

model Message {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content   String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
}

// NEW: Allows Agents and Clubs to save players via their Unique ID
model Shortlist {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("UserShortlists", fields: [userId], references: [id], onDelete: Cascade)

  talentId    String?
  talent      User?    @relation("TalentShortlisted", fields: [talentId], references: [id], onDelete: Cascade)
  playerId    String?
  player      Player?  @relation(fields: [playerId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}

// NEW: Facilitates direct communication between Admin, Academies, and Talents outside of deals
model DirectMessage {
  id          String   @id @default(cuid())
  senderId    String
  sender      User     @relation("SentDirectMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    User     @relation("ReceivedDirectMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  content     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}
